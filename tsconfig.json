{
    // TypeScript 全面移行の基盤設定（docs/spec-typescript-migration.ja.md 段階 0）
    //
    // 出力は Vite（lib mode）が担当します。tsc / vue-tsc は型検査にのみ使い、
    // 型定義の生成（declaration / emitDeclarationOnly）は段階 7 で有効化します。
    "compilerOptions": {
        "noEmit": true,

        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],

        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,

        // 段階 8 で引き上げ済み（移行仕様書 6-1 に記録）。
        // strictNullChecks は vue-router の型モデル差により未達で、
        // 解消には公開型 PresenterEntry.route の変更が必要なため false のまま残しています。
        // strictPropertyInitialization は strictNullChecks に依存するため連動します。
        "strict": false,
        "noImplicitAny": true,
        "strictNullChecks": false,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": false,
        "noImplicitThis": true,
        "useUnknownInCatchVariables": true,
        "alwaysStrict": true
    },
    // 対象はライブラリ本体のみです。demo / tests / e2e の .ts 化は行いません（仕様書 5-3）。
    "include": ["layerge/**/*.ts", "layerge/**/*.vue"],
    "exclude": ["node_modules", "dist"]
}
