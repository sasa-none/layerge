# 依存パッケージ
node_modules/

# ビルド生成物（ルート / demo / consumer-* のいずれも対象）
# 公開物には package.json の files フィールドで含まれるため、版管理からは外す
dist/

# npm pack の生成物・作業用アーカイブ
*.tgz
*.zip

# Playwright の出力
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Vite のキャッシュ
.vite/

# ログ
*.log

# 環境変数（秘匿値の誤コミット防止）
.env
.env.*

# .claude/ のローカル専用ファイル
# ディレクトリごと無視しない。agents/ や commands/ など、今後チームで
# 共有すべきものを置く場所になり得るため（CLAUDE.md / AGENTS.md と同じ扱い）
.claude/launch.json
.claude/settings.local.json

# エディタ / OS が生成するもの
.vscode/
.idea/
.DS_Store
Thumbs.db
