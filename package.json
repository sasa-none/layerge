{
    "name": "layerge",
    "version": "1.0.0",
    "description": "Presenter-style overlay navigation for Vue Router",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "CHANGELOG.md",
        "LICENSE",
        "index.d.cts",
        "index.d.ts",
        "README.md"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "vue",
        "vue-router",
        "overlay",
        "modal",
        "navigation",
        "presenter"
    ],
    "peerDependencies": {
        "vue": "^3.4.0",
        "vue-router": "^4.2.0 || ^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.60.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-prettier": "^10.2.0",
        "eslint": "^10.4.0",
        "eslint-plugin-jsdoc": "^63.0.0",
        "eslint-plugin-vue": "^10.9.1",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "npm-run-all": "^4.1.5",
        "postcss-html": "^1.8.1",
        "prettier": "^3.8.3",
        "stylelint": "^17.12.0",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.14",
        "vitest": "^4.1.7",
        "vue": "^3.5.35",
        "vue-eslint-parser": "^10.4.0",
        "vue-router": "^5.0.7",
        "vue-tsc": "^3.3.11"
    },
    "scripts": {
        "build": "vite build",
        "prepublishOnly": "npm run build",
        "demo:dev": "pnpm -C demo dev",
        "demo:build": "pnpm -C demo build",
        "format": "prettier --write \"layerge/**/*.{js,cjs,mjs,ts,vue}\" \"demo/src/**/*.{js,cjs,mjs,vue}\"",
        "lint": "run-p lint:*",
        "lint:check": "run-p lint:check:*",
        "lint:check:css": "stylelint -f verbose \"layerge/**/*.{vue,css,scss,sass}\" \"demo/src/**/*.{vue,css,scss,sass}\"",
        "lint:check:js": "eslint \"layerge/**/*.{js,cjs,mjs,ts,vue}\" \"demo/src/**/*.{js,cjs,mjs,vue}\"",
        "lint:js": "eslint --fix \"layerge/**/*.{js,cjs,mjs,ts,vue}\" \"demo/src/**/*.{js,cjs,mjs,vue}\"",
        "lint:css": "stylelint --fix -f verbose \"layerge/**/*.{vue,css,scss,sass}\" \"demo/src/**/*.{vue,css,scss,sass}\"",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "e2e:install": "playwright install chromium",
        "e2e:install-deps": "playwright install-deps chromium",
        "test:watch": "vitest"
    },
    "packageManager": "pnpm@11.4.0"
}
