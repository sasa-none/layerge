[*]
end_of_line = lf
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.rb]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.{js,jsx,ts,tsx,vue}]
indent_size = 4

[*.{html,htm,shtml,slim,pug,ejs}]
indent_size = 4

[*.{css,scss,sass,less,styl}]
indent_size = 4
